generator client {
   provider = "prisma-client"
  output          = "../src/generated/prisma"
  clientGenerators = ["esm"]
}

datasource db {
  provider = "mysql"
}

enum InventoryStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_ORDER
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?   @db.Text
  logo        String?
  website     String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([isActive])
  @@index([slug])
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  description String?
  price       Decimal       @db.Decimal(12, 2)
  isActive    Boolean       @default(true)
  isHit       Boolean       @default(false)
  categoryId  Int
  unitId      Int
  brandId     Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category      @relation(fields: [categoryId], references: [id])
  unit        Unit          @relation(fields: [unitId], references: [id])
  brand       Brand?        @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  inventory   Inventory?
  orderItems  OrderItem[]

  @@index([name])
  @@index([categoryId])
  @@index([unitId])
  @@index([brandId])
  @@index([isActive])
  @@index([isHit])
  @@index([price])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@index([isActive])
}

model Unit {
  id        Int       @id @default(autoincrement())
  name      String
  shortName String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)

  products  Product[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Inventory {
  productId Int             @id
  quantity  Int             @default(0)
  status    InventoryStatus @default(IN_STOCK)

  product   Product         @relation(fields: [productId], references: [id])
}

model Order {
  id          Int         @id @default(autoincrement())
  firstName   String
  lastName    String
  phone       String
  delivery    Boolean
  address     String?
  totalAmount Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  items       OrderItem[]

  @@index([createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String
  unit      String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
